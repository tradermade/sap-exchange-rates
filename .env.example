# TraderMade
TRADERMADE_API_KEY=your_tradermade_api_key

# SAP Market Rates Management (Bring Your Own Rates)
MRM_UPLOAD_URL=https://your-mrm-upload-url
MRM_TOKEN_URL=https://your-auth-url/oauth/token
MRM_CLIENT_ID=your_client_id
MRM_CLIENT_SECRET=your_client_secret

# Only if your credentials came from SAP Cloud Identity Services
MRM_RESOURCE=
